<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600.0" stylesheets="@styles.css" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ensenamex.ensenamex.PantallaPrincipalController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="15.0">
            <padding>
                <Insets left="40.0" right="40.0" top="10.0" />
            </padding>
            <children>
                <ImageView fx:id="logoHeader" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Logo.png" />
                    </image>
                </ImageView>
                <HBox alignment="CENTER">
                    <Text fill="#4CAF50" text="En">
                        <font>
                            <Font name="Wendy One" size="35.0" />
                        </font>
                    </Text>
                    <Text fill="#000000" text="seña">
                        <font>
                            <Font name="Wendy One" size="35.0" />
                        </font>
                    </Text>
                    <Text fill="#D32F2F" text="mex">
                        <font>
                            <Font name="Wendy One" size="35.0" />
                        </font>
                    </Text>
                </HBox>
                <HBox HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT">
                    <children>
                        <Text fx:id="usernameLbl" text="Usuario">
                            <font>
                                <Font name="Wendy One" size="18.0" />
                            </font>
                        </Text>
                        <Text fx:id="correoLbl" text="Usuario@gmail.com">
                            <font>
                                <Font name="Ysabeau SC Regular" size="16.0" />
                            </font>
                        </Text>
                    </children>
                </VBox>
                <ImageView styleClass="boton-volver"  fx:id="iconoUsuario" fitHeight="40.0" fitWidth="40.0" onMouseClicked="#mostrarMenuFlotante" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Iconos/User.png" />
                    </image>
                </ImageView>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="30.0">
            <padding>
                <Insets top="20.0" />
            </padding>
            <children>
                <HBox
                        alignment="CENTER_LEFT"
                        maxWidth="450"
                        prefHeight="55"
                        spacing="10"
                        onMouseClicked="#irABusqueda"
                        style="-fx-background-color:#EDE7F6;
                        -fx-background-radius:25;
                        -fx-cursor:hand;
                        -fx-padding:0 20;"
                        styleClass="search-bar">

                    <children>

                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">

                        </ImageView>


                        <Text
                                text="Buscar una seña..."
                                fill="#757575">

                            <font>
                                <Font name="Ysabeau SC Regular" size="20"/>
                            </font>

                        </Text>

                    </children>

                </HBox>

                <HBox alignment="CENTER" spacing="10.0" prefHeight="280.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>

                    <Button styleClass="boton-volver" onAction="#scrollLeft" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="70.0" fitWidth="70.0">
                                <image>
                                    <Image url="@Iconos/Arrow_left_circle.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <ScrollPane fx:id="scrollPane" fitToHeight="true" hbarPolicy="NEVER" prefWidth="1000.0" style="-fx-background-color: transparent; -fx-background: #FFFFFF; -fx-border-color: transparent;">
                        <content>
                            <HBox fx:id="carouselContainer" alignment="CENTER_LEFT" spacing="30.0" />
                        </content>
                    </ScrollPane>

                    <Button styleClass="boton-volver" onAction="#scrollRight" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="70.0" fitWidth="70.0">
                                <image>
                                    <Image url="@Iconos/Arrow_right_circle.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox>
            <children>
                <GridPane alignment="CENTER" prefHeight="120.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="34.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0" />
                    </columnConstraints>
                    <children>
                        <VBox alignment="CENTER_LEFT" GridPane.columnIndex="0">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <children>
                                <Text text="CONTACTANOS :)">
                                    <font>
                                        <Font name="Wendy One" size="20.0" />
                                    </font>
                                </Text>
                                <Text text="admin@ensenamex.com">
                                    <font>
                                        <Font name="Itim" size="14.0" />
                                    </font>
                                </Text>
                            </children>
                        </VBox>
                        <Button fx:id="btnAdd"
                                alignment="CENTER"
                                maxWidth="1.7976931348623157E308"
                                GridPane.columnIndex="1"
                                onAction="#irAgregarSena"
                                style="-fx-background-color: transparent;"
                                styleClass="boton-volver">
                            <graphic>
                                <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@Iconos/add_circle.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #EDE7F6; -fx-border-width: 3 0 0 0; -fx-border-insets: 0 50 0 50;">
                    <children>
                        <Text text="Enseñamex®">
                            <font>
                                <Font name="Itim" size="16.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Text>
                        <HBox HBox.hgrow="ALWAYS" />
                        <Text text="Copyright© 2026">
                            <font>
                                <Font name="Itim" size="16.0" />
                            </font>
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </Text>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>