<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="ensenamex.ensenamex.LoginController">
   <children>
      <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <ImageView fx:id="logoImageView" fitHeight="360.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true" />
            
            <HBox alignment="CENTER" spacing="0.0">
               <children>
                  <Text fill="#4CAF50" strokeType="OUTSIDE" strokeWidth="0.0" text="En">
                     <font>
                        <Font name="Wendy One" size="60.0" />
                     </font>
                  </Text>
                  <Text fill="#000000" strokeType="OUTSIDE" strokeWidth="0.0" text="seña">
                     <font>
                        <Font name="Wendy One" size="60.0" />
                     </font>
                  </Text>
                  <Text fill="#D32F2F" strokeType="OUTSIDE" strokeWidth="0.0" text="mex">
                     <font>
                        <Font name="Wendy One" size="60.0" />
                     </font>
                  </Text>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </HBox>
            
            <TextField fx:id="username"  maxWidth="400.0" promptText="Usuario" style="-fx-background-color: #EDE7F6; -fx-background-radius: 25; -fx-prompt-text-fill: #9E9E9E; -fx-text-fill: #333333;">
               <font>
                  <Font name="Ysabeau SC Regular" size="22.0" />
               </font>
               <padding>
                  <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
               </padding>
               <effect>
                  <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0" color="#00000026" />
               </effect>
            </TextField>
            
            <PasswordField fx:id="contra"  maxWidth="400.0" promptText="Contraseña" style="-fx-background-color: #EDE7F6; -fx-background-radius: 25; -fx-prompt-text-fill: #9E9E9E; -fx-text-fill: #333333;">
               <font>
                  <Font name="Ysabeau SC Regular" size="22.0" />
               </font>
               <padding>
                  <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
               </padding>
               <effect>
                  <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0" color="#00000033" />
               </effect>
            </PasswordField>
            
            <Button fx:id="btnEntrar"  onAction="#entrar"  mnemonicParsing="false" prefWidth="350.0" style="-fx-background-color: #388E3C; -fx-background-radius: 25;" text="Entrar" textFill="WHITE">
               <font>
                  <Font name="Wendy One" size="30.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <effect>
                  <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0" color="#00000033" />
               </effect>
            </Button>
            
            <Hyperlink onAction="#irARegistro" style="-fx-underline: true;" text="Regístrate aquí" textFill="BLACK">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </Hyperlink>
            
         </children>
      </VBox>
      
      <HBox alignment="CENTER_LEFT" layoutY="560.0" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #EDE7F6; -fx-border-width: 3 0 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enseñamex®" textOrigin="CENTER">
               <font>
                  <Font name="Itim" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
            </Text>
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Copyright© 2026" textOrigin="CENTER">
                     <font>
                        <Font name="Itim" size="16.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="15.0" />
                     </HBox.margin>
                  </Text>
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
